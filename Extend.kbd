(defsrc
1 2 3 4 5 6 7 8 9 0 - =
q w e r t y u i o p
a s d f g h j k l ;
z x c v b n m , . /
caps spc
lctl lmet lalt
)

(deflayer eng ;; Colemak
_ _ _ _ _ _ _ _ _ _ _ _
_ _ f p g j l u y ;
_ r s t d _ n e i o
_ _ _ _ _ k _ _ _ _
@rus @spc
_ _ _
)

(deflayer rus ;; Йцукенг
_ _ _ _ _ _ _ _ _ _ _ _
_ _ _ _ _ _ _ _ _ _
_ _ _ _ _ _ _ _ _ _
_ _ _ _ _ _ _ _ _ _
@eng @spc
@ctl @met @alt
)

(deflayer noremap
_ _ _ _ _ _ _ _ _ _ _ _
_ _ _ _ _ _ _ _ _ _
_ _ _ _ _ _ _ _ _ _
_ _ _ _ _ _ _ _ _ _
@cap _
_ _ _
)

(platform (win winiov2 wintercept)
(deflayer nav
f1   f2       f3    f4       f5    f6  f7   f8   f9   f10  f11 f12
A-f4 C-S-tab  tab   C-tab    esc   esc home up   end  lrld
lmet lalt     lctl  lsft     prnt  ret left down rght bspc
del  C-M-left M-tab C-M-rght lmet  tab pgup menu pgdn del
@cw XX
rctl rmet ralt
)
)

(platform (linux)
(deflayer nav
f1   f2       f3    f4       f5    f6  f7   f8   f9   f10  f11 f12
C-q  C-S-tab  tab   C-tab    esc   esc home up   end  lrld
lmet lalt     lctl  lsft     prnt  ret left down rght bspc
del  C-M-left M-w   C-M-rght A-spc tab pgup menu pgdn del
@cw XX
rctl rmet ralt
)
)

(platform (macos)
(deflayer nav
f1   f2       f3    f4       f5    f6  f7   f8   f9   f10  f11 f12
M-q  M-S-[    tab   M-S-]    esc   esc M-left up M-rght lrld
lctl lmet     lalt  lsft     M-S-4 ret left down rght bspc
bspc C-left   C-up  C-rght   M-spc tab pgup menu pgdn del
@cw XX
rctl rmet ralt
)
)

(deflayer switcher
_ _ _ _ _ _ _ _ _ _ _ _
_ _ _ _ _ _ _ _ _ _
_ @nor @rus @eng _ _ _ _ _ _
_ _ _ _ _ _ _ _ _ _
_ _
_ _ _
)

(defalias
C-8 en
C-9 ru
eng (tap-hold 200 195 (multi (layer-switch eng) @en) (layer-while-held switcher))
rus (tap-hold 200 195 (multi (layer-switch rus) @ru) (layer-while-held switcher))
nor (multi (layer-switch noremap) @en)
spc (tap-hold 200 195 spc (layer-while-held nav))
cap (tap-hold 200 195 caps (layer-while-held switcher))

ctl (multi lctl (layer-while-held eng))
met (multi lmet (layer-while-held eng))
alt (multi lalt (layer-while-held eng))

cw (switch ((base-layer rus)) (caps-word-custom 2000 (a b c d e f g h i j k l m n o p q r s t u v w x y z , . ' ; [ ]) (bspc del)) break () (caps-word 2000) break )
)
